---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/silkscreen/400.css";
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title = "Agent Toolkit — a place for real agent work",
  description = "A semantic AI developer workspace. Projects become places, People are reusable collaborators, and real sessions make work visible.",
  image = "/site/og-card.jpg",
  noIndex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://agent-toolkit.io").href;
const socialImage = new URL(image, "https://agent-toolkit.io").href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Agent Toolkit Desktop",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS, Windows",
  url: "https://agent-toolkit.io/",
  downloadUrl:
    "https://github.com/ulises-jeremias/agent-toolkit/releases/latest",
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10252a" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    {!noIndex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://github.com" />
    <link rel="preconnect" href="https://raw.githubusercontent.com" />
    <title>{title}</title>
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agent Toolkit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agent Toolkit Desktop — a cozy pixel valley where projects are places and live agent sessions are visible" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Agent Toolkit Desktop — a cozy pixel valley where projects are places and live agent sessions are visible" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
