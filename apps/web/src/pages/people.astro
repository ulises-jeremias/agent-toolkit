---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LegacyDesktopNotice from "@/components/LegacyDesktopNotice.astro";
import roster from "../../../../static/screenshots/people.png";
---

<SiteLayout
  title="People — legacy Agent Toolkit Desktop archive"
  description="Historical People identity model and screenshots from the retired Agent Toolkit Desktop. Current portable personas are agent definitions."
>
  <LegacyDesktopNotice subject="People" />
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Historical product archive</p>
      <h1>People in the former Desktop.</h1>
      <p class="lede">
        The legacy application used People as durable local identities tied to
        its own session UI. That runtime is retired. Agent Toolkit continues to
        provide portable agent definitions and personas for compatible coding
        tools; Veasel Code owns current sessions.
      </p>
      <figure class="pixel-frame page-hero-art">
        <img
          src={roster.src}
          alt="Archived screenshot of the legacy Agent Toolkit Desktop People interface"
          fetchpriority="high"
        />
        <figcaption class="hero-caption">
          Archived screenshot · not a current supported application
        </figcaption>
      </figure>
      <div class="button-row">
        <a class="button" href="/capabilities/">
          Find portable agent capabilities
        </a>
        <a class="button secondary" href="https://www.veasel.dev/downloads/">
          Get Veasel Code
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
