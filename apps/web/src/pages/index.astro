---
import SiteLayout from "@/layouts/SiteLayout.astro";
import UpstreamFlow from "@/components/UpstreamFlow.astro";
import { getCapabilities } from "@/lib/catalog";

const capabilities = await getCapabilities();
---

<SiteLayout
  title="Agent Toolkit — portable capabilities for coding agents"
  description="A practical, portable library of skills, agent definitions, MCP templates, context packs and workflows for the coding tools you already use."
>
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span> A portable
          capability library
        </p>
        <h1>Good tools make room for good work.</h1>
        <p class="home-lede">
          Keep the useful parts of your AI workflow: skills (including the{" "}
          <code>/work</code> router, <code>arena</code>, and{" "}
          <code>pr-ship</code>), agent definitions, MCP templates, context packs
          and repeatable recipes—plus Goal v1/v2 contracts and blinded evals,
          delivered by a native V CLI across the coding tools you choose.
        </p>
        <div class="button-row">
          <a class="button button--sun" href="/capabilities/">
            Browse the library <span aria-hidden="true">↗</span>
          </a>
          <a class="button button--outline" href="/docs/installation/">
            Install the CLI
          </a>
        </div>
        <p class="home-proof">
          <strong>{capabilities.length}</strong> catalog entries, built from the
          repository's checked-in sources.
        </p>
      </div>

      <figure class="toolkit-map" aria-labelledby="toolkit-map-caption">
        <div class="map-topline">
          <span>THE PORTABLE KIT</span>
          <span class="map-status">
            <i aria-hidden="true"></i> source tracked
          </span>
        </div>
        <div class="map-source">
          <div class="map-source-icon" aria-hidden="true">
            <span>✳</span>
          </div>
          <div>
            <strong>One library</strong>
            <span>versioned · inspectable · yours</span>
          </div>
        </div>
        <div class="map-branches" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="map-capabilities">
          <span>
            <b>✦</b> Skills
          </span>
          <span>
            <b>⌘</b> Agent definitions
          </span>
          <span>
            <b>⌁</b> MCP templates
          </span>
          <span>
            <b>↻</b> Workflows
          </span>
        </div>
        <div class="map-destinations-label">Choose a compatible home</div>
        <div
          class="map-destinations"
          aria-label="Example supported coding tools"
        >
          <span>Claude Code</span>
          <span>Codex</span>
          <span>Cursor</span>
          <span>OpenCode</span>
          <span>Veasel</span>
        </div>
        <figcaption id="toolkit-map-caption">
          Preview targets and provenance before you apply a capability.
        </figcaption>
        <span class="map-stamp" aria-hidden="true">
          OPEN
          <br />
          BY DESIGN
        </span>
      </figure>
    </div>
    <div class="hero-edge" aria-hidden="true"></div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">A kit, not a second workspace</p>
          <h2>
            Keep your capabilities close.
            <br />
            <em>Keep your choices open.</em>
          </h2>
        </div>
        <p>
          Agent Toolkit organizes reusable pieces and helps you place them in
          the tools that support them. It does not replace your coding agent or
          silently copy files into a project.
        </p>
      </div>
      <div class="capability-cards">
        <article class="capability-card capability-card--skills">
          <span class="card-glyph" aria-hidden="true">
            ✦
          </span>
          <p class="card-type">INSTRUCTIONS</p>
          <h3>Skills</h3>
          <p>
            Focused playbooks for work you do more than once: <code>/work</code>{" "}
            engineering routing, <code>arena</code> multi-model review,{" "}
            <code>pr-ship</code> delivery, security, design and more.
          </p>
          <a href="/capabilities/">
            Explore skills <span aria-hidden="true">→</span>
          </a>
        </article>
        <article class="capability-card capability-card--agents">
          <span class="card-glyph" aria-hidden="true">
            ◉
          </span>
          <p class="card-type">ROLE & CONTEXT</p>
          <h3>Agents & context</h3>
          <p>
            Portable personas and project context that explain how a tool should
            approach the work.
          </p>
          <a href="/capabilities/">
            Explore the catalog <span aria-hidden="true">→</span>
          </a>
        </article>
        <article class="capability-card capability-card--integrations">
          <span class="card-glyph" aria-hidden="true">
            ⌁
          </span>
          <p class="card-type">CONNECTIONS</p>
          <h3>MCP & workflows</h3>
          <p>
            Inspectable MCP templates, bounded loops, Goal v1/v2 manifests,
            solution packs and blinded real-task evals with requirements stated
            up front.
          </p>
          <a href="/docs/compatibility/">
            Check compatibility <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="wrap roles-layout">
      <div class="roles-intro">
        <p class="section-kicker">Three clear roles</p>
        <h2>Use the right tool for the part you need.</h2>
        <p>
          Portable capabilities stay useful across tools. When you want an
          integrated coding workspace, Veasel Code brings the graphical app and
          terminal client together.
        </p>
        <a class="text-link" href="https://www.veasel.dev/downloads/">
          Explore Veasel Code <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="role-list">
        <article class="role-row role-row--active">
          <span class="role-index">01</span>
          <div>
            <h3>Agent Toolkit</h3>
            <p>
              Portable skills, agents, context, MCP templates, workflows and
              CLI.
            </p>
          </div>
          <span class="role-badge">THIS LIBRARY</span>
        </article>
        <article class="role-row">
          <span class="role-index">02</span>
          <div>
            <h3>Veasel Code</h3>
            <p>
              The supported coding app: Desktop and TUI, one backend and shared
              sessions.
            </p>
          </div>
          <a href="https://www.veasel.dev/" aria-label="Visit Veasel Code">
            ↗
          </a>
        </article>
        <article class="role-row">
          <span class="role-index">03</span>
          <div>
            <h3>Official Veasel catalog</h3>
            <p>
              Reviewed plugin manifests and provenance for the Veasel runtime.
            </p>
          </div>
          <a
            href="https://github.com/veasel-labs/agent-toolkit"
            aria-label="Browse the official Veasel catalog"
          >
            ↗
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--paper upstream-summary">
    <div class="wrap">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-kicker">A careful route from upstream</p>
          <h2>Updates arrive as proposals, not silent changes.</h2>
        </div>
        <div>
          <p>
            We pin the source, compare the bytes and keep provenance with the
            capability. A human reviews the change before its trust state can be
            renewed.
          </p>
          <a class="text-link text-link--dark" href="/docs/upstream-sync/">
            See how upstream sync works <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <UpstreamFlow />
    </div>
  </section>

  <section class="section section--paper section--install">
    <div class="wrap install-card">
      <div>
        <p class="section-kicker">Start small</p>
        <h2>Look around before anything changes.</h2>
        <p>
          Install the CLI, inspect detected tools, and preview exact
          destinations. Apply only the capabilities you want; existing files
          remain yours.
        </p>
      </div>
      <div class="install-action">
        <code>uv tool install agent-toolkit-cli</code>
        <a class="button button--dark" href="/docs/installation/">
          Read the install guide <span aria-hidden="true">→</span>
        </a>
        <a
          class="text-link text-link--dark"
          href="https://github.com/ulises-jeremias/agent-toolkit"
        >
          Browse the source on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
