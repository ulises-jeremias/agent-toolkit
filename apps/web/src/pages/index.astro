---
import SiteLayout from "@/layouts/SiteLayout.astro";
import world from "../../../../static/screenshots/world.png";
import interior from "../../../../static/screenshots/project-interior.png";
import people from "../../../../static/screenshots/people.png";
import operations from "../../../../static/screenshots/operations.png";
import library from "../../../../static/screenshots/library.png";
import house from "../../../desktop/public/world/house-cottage.png";
import libraryLandmark from "../../../desktop/public/world/landmark-library.png";
import operationsLandmark from "../../../desktop/public/world/landmark-operations.png";
import { getCapabilities, countByKind } from "@/lib/catalog";

const capabilities = await getCapabilities();
const counts = countByKind(capabilities);
---

<SiteLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="eyebrow">A semantic workspace for real agent work</p>
      <h1>Your AI agents finally have a place to work.</h1>
      <p class="lede">
        Projects become places. People become reusable collaborators. Skills,
        memory and real agent sessions come together in one workspace you can
        understand at a glance.
      </p>
      <div class="button-row">
        <a class="button" href="/download/">
          Explore Desktop{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a class="button secondary" href="/world/">
          Walk through the world{" "}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <p class="hero-footnote">
        <strong>No pretend workers.</strong> A character appears only when a
        real session is running.
      </p>
      <figure class="hero-art">
        <div class="pixel-frame hero-screen">
          <img
            src={world.src}
            alt="Agent Toolkit Desktop's actual pixel valley: project houses, shared Library and Operations landmarks, paths, creek and woods"
            fetchpriority="high"
          />
        </div>
        <figcaption class="hero-caption">
          <span>The workspace is the map.</span>
          <span>Projects · People · Operations</span>
        </figcaption>
        <div class="hero-sign">
          <span>REAL PROJECTS</span>
          <br />
          real places to work
        </div>
      </figure>
    </div>
  </section>

  <div class="quote-strip">
    A WORLD THAT EXPLAINS YOUR WORK — NOT WALLPAPER BEHIND IT
  </div>

  <section class="section section--deep">
    <div class="wrap home-story">
      <div class="section-intro">
        <p class="section-kicker">The map is information architecture</p>
        <h2>Every place has a reason to be there.</h2>
        <p>
          Agent Toolkit gives a spatial home to the parts of agent development
          that belong together. Click a place to reach the same real workflow
          available through menus, direct navigation and the keyboard.
        </p>
        <a class="quiet-link" href="/world/">
          See what the places mean <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="story-beacon">
        <div>
          <img src={house.src} alt="" width="46" height="46" loading="lazy" />
          <strong>Projects</strong>
          <p>Each registered project has its own building and context.</p>
        </div>
        <div>
          <img
            src={libraryLandmark.src}
            alt=""
            width="46"
            height="46"
            loading="lazy"
          />
          <strong>Library</strong>
          <p>Discover reusable Skills, Agent Definitions, MCP and Loops.</p>
        </div>
        <div>
          <img
            src={operationsLandmark.src}
            alt=""
            width="46"
            height="46"
            loading="lazy"
          />
          <strong>Operations</strong>
          <p>Inspect real jobs, Swarms, schedules and approvals.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--glow">
    <div class="wrap scene-grid">
      <div class="scene-copy">
        <p class="section-kicker">Project · a place with its own context</p>
        <h2>Enter a house. You're in that project.</h2>
        <p>
          The room brings actual project resources into reach. Files open the
          registered project tree. Knowledge and Memory stay distinct. The
          terminal is a real PTY, not a mock console.
        </p>
        <ul>
          <li>Project board and actual context</li>
          <li>Files, knowledge and memory with clear boundaries</li>
          <li>Terminal sessions remain real across navigation</li>
        </ul>
        <p style="margin-top: 24px">
          <a class="quiet-link" href="/docs/desktop/">
            Tour the Desktop <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <figure class="pixel-frame scene-image">
        <img
          src={interior.src}
          alt="Actual Agent Toolkit project interior showing a warm pixel room with a project overview and semantic work areas"
          loading="lazy"
        />
        <figcaption class="screen-caption">
          <span>PROJECT INTERIOR</span>
          <span>files · knowledge · terminal</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap scene-grid reverse">
      <div class="scene-copy">
        <p class="section-kicker">People · identity that survives a session</p>
        <h2>Build a team you can bring back.</h2>
        <p>
          A Person keeps a durable identity, role, goal, preferred runner and
          model. An Agent Definition describes reusable behavior. A session is
          the real process. A Swarm role is temporary responsibility.
        </p>
        <p>
          Offline People stay in the roster. Only a live session tied to a
          project appears in the world, and that same session can open its real
          terminal.
        </p>
        <a class="quiet-link" href="/people/">
          Meet People <span aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="pixel-frame scene-image">
        <img
          src={people.src}
          alt="Actual Agent Toolkit People roster showing saved collaborators and their configured roles"
          loading="lazy"
        />
        <figcaption class="screen-caption">
          <span>PEOPLE</span>
          <span>durable identity · real sessions</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--green">
    <div class="wrap scene-grid">
      <div class="scene-copy">
        <p class="section-kicker">Operations · understand what is happening</p>
        <h2>Coordinate work. Keep the truth visible.</h2>
        <p>
          Swarms assign People to temporary roles, review plans and approvals,
          and collect handoffs and artifacts. Loops run recurring workflows.
          Operations shows the actual run state; the World shows where live work
          belongs.
        </p>
        <ul>
          <li>Review topology, roles and runner/model bindings</li>
          <li>Approve, pause, resume or stop through the typed backend</li>
          <li>Inspect artifacts, logs and recovery state</li>
        </ul>
        <p style="margin-top: 24px">
          <a class="quiet-link" href="/swarms/">
            How Swarms work <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <figure class="pixel-frame scene-image">
        <img
          src={operations.src}
          alt="Actual Operations inspector listing real jobs and swarm runs with their current states"
          loading="lazy"
        />
        <figcaption class="screen-caption">
          <span>OPERATIONS</span>
          <span>runs · gates · recovery</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap scene-grid reverse">
      <div class="scene-copy">
        <p class="section-kicker">
          Library · reusable capability, not project knowledge
        </p>
        <h2>Give each collaborator the right tools.</h2>
        <p>
          Browse real Skills, Agent Definitions, MCP providers, Loops and
          distributions from Toolkit's generated catalogs. Review requirements
          and targets before installation; receipts show what actually changed.
        </p>
        <p>
          <strong>{counts.get("Skill") ?? 0} Skills</strong> ·{" "}
          <strong>
            {counts.get("Agent Definition") ?? 0} Agent Definitions
          </strong>{" "}
          · <strong>{counts.get("Loop") ?? 0} Loops</strong> in the current
          catalogs.
        </p>
        <a class="quiet-link" href="/capabilities/">
          Browse the catalog <span aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="pixel-frame scene-image">
        <img
          src={library.src}
          alt="Actual Agent Toolkit Library showing discovered capabilities in a project of the pixel world"
          loading="lazy"
        />
        <figcaption class="screen-caption">
          <span>LIBRARY</span>
          <span>catalog truth · install evidence</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--glow">
    <div class="wrap">
      <div class="section-intro">
        <p class="section-kicker">One idea, many ways in</p>
        <h2>Explore spatially. Work the way you prefer.</h2>
        <p>
          Walk the map with your pointer, jump straight from the command
          palette, use keyboard navigation, or open a conventional inspector.
          They reach the same canonical operations. Nothing requires a CLI for
          everyday Desktop work.
        </p>
      </div>
      <div class="semantic-list">
        <div class="semantic-item">
          <span class="term">PROJECT</span>
          <p>
            <strong>Building</strong>
            <br />A real registered project.
          </p>
        </div>
        <div class="semantic-item">
          <span class="term">CAPABILITIES</span>
          <p>
            <strong>Library</strong>
            <br />
            Reusable and discoverable.
          </p>
        </div>
        <div class="semantic-item">
          <span class="term">DURABLE CONTEXT</span>
          <p>
            <strong>Memory / Archive</strong>
            <br />
            Remembered records, not files.
          </p>
        </div>
        <div class="semantic-item">
          <span class="term">AUTOMATION</span>
          <p>
            <strong>Operations</strong>
            <br />
            Jobs, Loops and Swarms.
          </p>
        </div>
        <div class="semantic-item">
          <span class="term">DIRECT CONTROL</span>
          <p>
            <strong>Terminal</strong>
            <br />A real shell session.
          </p>
        </div>
        <div class="semantic-item">
          <span class="term">RUNTIME</span>
          <p>
            <strong>People at work</strong>
            <br />
            Only while their real session runs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap closing-banner">
      <p class="section-kicker">Step into your workspace</p>
      <h2>Make room for real work.</h2>
      <p>
        Start with Agent Toolkit Desktop. Use the CLI when you want automation,
        scripting or a headless workflow.
      </p>
      <div class="button-row">
        <a class="button" href="/download/">
          Choose your download{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a class="button secondary" href="/docs/getting-started/">
          Read the quick start
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
