---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LegacyDesktopNotice from "@/components/LegacyDesktopNotice.astro";
import room from "../../../../docs/desktop/assets/electron/world-review-2026-10-09/project-interior-large.png";
---

<SiteLayout
  title="World — legacy Agent Toolkit Desktop archive"
  description="Historical World concept and screenshots from the retired Agent Toolkit Desktop."
>
  <LegacyDesktopNotice subject="World" />
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Historical product archive</p>
      <h1>The former Agent Toolkit World.</h1>
      <p class="lede">
        This page preserves the World design and source screenshot from the
        legacy Toolkit Desktop. It is not a guide to a supported Agent Toolkit
        application. Veasel Code owns the current Desktop and its optional
        runtime-backed World.
      </p>
      <figure class="pixel-frame page-hero-art">
        <div class="page-hero-image">
          <img
            src={room.src}
            alt="Historical Agent Toolkit Desktop project interior screenshot, retained as an archive"
            fetchpriority="high"
          />
        </div>
        <figcaption class="hero-caption">
          Archived screenshot · legacy application · not current runtime state
        </figcaption>
      </figure>
      <div class="button-row">
        <a class="button" href="https://www.veasel.dev/downloads/">
          Explore Veasel Code
        </a>
        <a class="button secondary" href="/capabilities/">
          Browse portable capabilities
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
