---
import SiteLayout from "@/layouts/SiteLayout.astro";
import LegacyDesktopNotice from "@/components/LegacyDesktopNotice.astro";
import swarmStart from "../../../../docs/desktop/assets/electron/swarms/swarm-start-large.png";
---

<SiteLayout
  title="Swarms — legacy Agent Toolkit Desktop archive"
  description="Historical Swarms interface and screenshots from the retired Agent Toolkit Desktop. Portable workflow recipes remain available in the Toolkit CLI."
>
  <LegacyDesktopNotice subject="Desktop Swarms interface" />
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Historical product archive</p>
      <h1>Swarms in the former Desktop.</h1>
      <p class="lede">
        This image records the old Desktop's Swarms review screen. The
        application-specific Operations interface is retired. Portable workflow
        recipes remain part of Agent Toolkit, while Veasel Code owns the
        supported graphical session runtime.
      </p>
      <figure class="pixel-frame page-hero-art">
        <img
          src={swarmStart.src}
          alt="Archived screenshot of the legacy Agent Toolkit Desktop Swarms review screen"
          fetchpriority="high"
        />
        <figcaption class="hero-caption">
          Archived screenshot · no current sessions or activity are represented
        </figcaption>
      </figure>
      <div class="button-row">
        <a class="button" href="/docs/swarms/">
          Read portable workflow documentation
        </a>
        <a class="button secondary" href="https://www.veasel.dev/downloads/">
          Get Veasel Code
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
