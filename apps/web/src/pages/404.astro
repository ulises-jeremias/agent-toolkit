---
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout
  title="Not found — Agent Toolkit"
  description="That Agent Toolkit page could not be found."
  noIndex={true}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Page not found</p>
      <h1>This page has moved or no longer exists.</h1>
      <p class="lede">
        Browse the capability catalog and current CLI guides, or visit Veasel
        Code for the graphical coding application.
      </p>
      <div class="button-row">
        <a class="button" href="/">
          Explore capabilities{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        <a class="button secondary" href="/docs/">
          Open documentation
        </a>
        <a class="button secondary" href="https://www.veasel.dev/downloads/">
          Get Veasel Code
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
