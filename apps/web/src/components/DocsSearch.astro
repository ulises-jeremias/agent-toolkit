---
interface Props {
  id?: string;
}
const { id = "docs-search" } = Astro.props;
const inputId = `${id}-input`;
const resultsId = `${id}-results`;
const statusId = `${id}-status`;
---

<search class="docs-search" data-docs-search data-pagefind-ignore>
  <label class="docs-search-label" for={inputId}>
    <span class="docs-search-sign" aria-hidden="true">
      Library · Search
    </span>
    Search the documentation
  </label>
  <div class="docs-search-box">
    <input
      id={inputId}
      data-docs-search-input
      type="search"
      name="q"
      placeholder="Try “swarm roles” or “installation”…"
      autocomplete="off"
      aria-describedby={statusId}
      aria-controls={resultsId}
    />
    <button
      type="button"
      class="docs-search-clear"
      data-docs-search-clear
      hidden
    >
      Clear
    </button>
  </div>
  <p
    id={statusId}
    class="docs-search-status"
    data-docs-search-status
    role="status"
  >
    Full-text search over the canonical guides. Results link to the exact
    heading.
  </p>
  <div
    id={resultsId}
    data-docs-search-results
    class="docs-search-results"
    hidden
  ></div>
</search>

<script>
  type PagefindSubResult = {
    url: string;
    title: string;
    excerpt: string;
  };
  type PagefindResult = {
    id: string;
    data: () => Promise<{
      url: string;
      meta: { title?: string };
      excerpt: string;
      sub_results: PagefindSubResult[];
    }>;
  };
  type Pagefind = {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindResult[] } | null>;
  };

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-docs-search]",
  )) {
    const input = root.querySelector<HTMLInputElement>(
      "[data-docs-search-input]",
    );
    const clear = root.querySelector<HTMLButtonElement>(
      "[data-docs-search-clear]",
    );
    const status = root.querySelector<HTMLElement>("[data-docs-search-status]");
    const resultsBox = root.querySelector<HTMLElement>(
      "[data-docs-search-results]",
    );
    if (!input || !clear || !status || !resultsBox) continue;

    let pagefindPromise: Promise<Pagefind> | null = null;
    let debounce = 0;
    let latestQuery = "";

    const loadPagefind = () => {
      pagefindPromise ??= (async () => {
        // Generated by `pagefind` after `astro build` into dist/pagefind/.
        // Absent in `astro dev`, where search degrades to a clear notice.
        const pagefindUrl: string = "/pagefind/pagefind.js";
        const mod = (await import(/* @vite-ignore */ pagefindUrl)) as Pagefind;
        await mod.init();
        return mod;
      })();
      return pagefindPromise;
    };

    const close = () => {
      resultsBox.hidden = true;
      resultsBox.replaceChildren();
    };

    const render = async (query: string) => {
      let pagefind: Pagefind;
      try {
        pagefind = await loadPagefind();
      } catch {
        if (query !== latestQuery) return;
        status.textContent =
          "Search index is not available yet — it is generated by the production build. Browse the guides below instead.";
        close();
        return;
      }
      const response = await pagefind.search(query);
      if (query !== latestQuery) return;
      const results = response?.results ?? [];
      close();
      if (results.length === 0) {
        status.textContent = `No guides match “${query}”. Try a shorter or different term.`;
        return;
      }
      const loaded = await Promise.all(
        results.slice(0, 8).map((result) => result.data()),
      );
      if (query !== latestQuery) return;
      const list = document.createElement("ul");
      list.className = "docs-search-list";
      for (const page of loaded) {
        const item = document.createElement("li");
        item.className = "docs-search-item";
        const title = document.createElement("a");
        title.href = page.url;
        title.textContent = page.meta.title ?? page.url;
        title.className = "docs-search-page";
        item.append(title);
        const subs = page.sub_results.slice(0, 3);
        if (subs.length > 0) {
          const subList = document.createElement("ul");
          subList.className = "docs-search-subs";
          for (const sub of subs) {
            const subItem = document.createElement("li");
            const link = document.createElement("a");
            link.href = sub.url;
            link.textContent = sub.title;
            const excerpt = document.createElement("span");
            excerpt.className = "docs-search-excerpt";
            // Pagefind excerpts are generated from this site's own rendered
            // canonical docs and only add <mark> highlighting.
            excerpt.innerHTML = sub.excerpt;
            subItem.append(link, excerpt);
            subList.append(subItem);
          }
          item.append(subList);
        } else {
          const excerpt = document.createElement("p");
          excerpt.className = "docs-search-excerpt";
          excerpt.innerHTML = page.excerpt;
          item.append(excerpt);
        }
        list.append(item);
      }
      resultsBox.append(list);
      resultsBox.hidden = false;
      status.textContent = `${results.length} guide${results.length === 1 ? "" : "s"} match “${query}”. Use ↓ to jump into the results, Esc to clear.`;
    };

    input.addEventListener("input", () => {
      const query = input.value.trim();
      latestQuery = query;
      clear.hidden = query.length === 0;
      window.clearTimeout(debounce);
      if (query.length < 2) {
        close();
        status.textContent =
          "Full-text search over the canonical guides. Results link to the exact heading.";
        return;
      }
      status.textContent = "Searching…";
      debounce = window.setTimeout(() => void render(query), 180);
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        input.value = "";
        input.dispatchEvent(new Event("input"));
        input.focus();
      }
      if (event.key === "ArrowDown") {
        const first = resultsBox.querySelector<HTMLElement>("a");
        if (first) {
          event.preventDefault();
          first.focus();
        }
      }
    });
    resultsBox.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      if (event.key === "Escape") {
        input.value = "";
        input.dispatchEvent(new Event("input"));
        input.focus();
        return;
      }
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      const links = [...resultsBox.querySelectorAll<HTMLElement>("a")];
      const index = links.indexOf(target as HTMLAnchorElement);
      if (index === -1) return;
      event.preventDefault();
      const next =
        event.key === "ArrowDown"
          ? links[index + 1]
          : (links[index - 1] ?? input);
      next?.focus();
    });
    clear.addEventListener("click", () => {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });
  }
</script>
