---
interface Props {
  subject: string;
}
const { subject } = Astro.props;
---

<aside class="legacy-desktop-notice" aria-label="Legacy Desktop archive notice">
  <div class="wrap">
    <strong>Archived legacy Desktop reference: {subject}</strong>
    <p>
      This page describes the retired Agent Toolkit Desktop and does not
      document a currently supported application. Agent Toolkit is now the
      portable capability toolkit; Veasel Code is the supported graphical coding
      application. Legacy Toolkit data is not imported automatically.
    </p>
    <div class="button-row">
      <a class="button" href="https://www.veasel.dev/downloads/">
        Get Veasel Code
      </a>
      <a class="button secondary" href="/capabilities/">
        Explore Toolkit capabilities
      </a>
    </div>
  </div>
</aside>
