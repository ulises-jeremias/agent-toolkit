---
/* Replacement for the screenshot-switching WorldJourney (#1759 D):
   semantic destination signposts linking real routes. No JS, no fake
   live sessions or metrics; content is usable without JavaScript.
   TODO(#1759-B): swap the CSS .valley-scene layers for governed PXL
   website art when Agent B assets land; keep these routes/labels. */
const destinations = [
  {
    sign: "Trailhead",
    title: "Start here",
    body: "Your first hour: download, open Desktop and run reviewed agent work.",
    href: "/start/",
  },
  {
    sign: "Project District",
    title: "Projects as places",
    body: "Every registered project has a place, its files, knowledge and terminal.",
    href: "/world/",
  },
  {
    sign: "Library",
    title: "Docs & capabilities",
    body: "Canonical guides plus reusable Skills, Agents, MCP and Loops.",
    href: "/docs/",
  },
  {
    sign: "Guild Hall",
    title: "People",
    body: "Reusable collaborators with durable identity. People appear in the world only while a real session runs.",
    href: "/people/",
  },
  {
    sign: "Operations Hall",
    title: "Swarms & operations",
    body: "Coordinate real sessions, review roles and follow handoffs and approvals.",
    href: "/swarms/",
  },
  {
    sign: "Workshop",
    title: "Capabilities & integrations",
    body: "Browse what is installed, configured and discoverable.",
    href: "/capabilities/",
  },
  {
    sign: "Waystation",
    title: "Download",
    body: "Get Agent Toolkit Desktop v1.49.0 for Linux, macOS or Windows.",
    href: "/download/",
  },
  {
    sign: "Town Square",
    title: "Community",
    body: "Source, issues, contributing and security — built in the open.",
    href: "/community/",
  },
  {
    sign: "Chronicles",
    title: "Changelog",
    body: "Release history rendered from the canonical repository changelog.",
    href: "/changelog/",
  },
];
---

<section class="valley-destinations" aria-labelledby="destinations-title">
  <div class="wrap">
    <p class="section-kicker">Hornero Valley · choose a destination</p>
    <h2 id="destinations-title">Follow a signpost. Arrive at real work.</h2>
    <p>
      Each place in the valley is a real route and a real workflow. Use the
      signposts below, the navigation above, or your keyboard — all reach the
      same destinations.
    </p>
    <div
      class="valley-scene"
      role="img"
      aria-label="Layered Hornero Valley scene: green hills, a sunlit path and dark pine ridges"
    ></div>
    <div class="destination-grid">
      {destinations.map((d) => (
        <a class="destination-card" href={d.href}>
          <span class="sign">{d.sign}</span>
          <strong>{d.title}</strong>
          <p>{d.body}</p>
          <span class="go">
            Go there <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
    <aside class="truth-note">
      <strong>v1.49.0 is released</strong> — the PXL Renaissance release.
      Daily-driver acceptance with real providers is still in development; it is
      not claimed as done. Follow{" "}
      <a href="https://github.com/ulises-jeremias/agent-toolkit/issues/1673">
        issue #1673
      </a>
      .
    </aside>
  </div>
</section>
