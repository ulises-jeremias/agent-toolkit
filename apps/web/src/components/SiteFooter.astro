---
import worldMark from "../../../desktop/public/world/landmark-workspace.png";
---

<footer class="site-footer">
  <div class="footer-landscape" aria-hidden="true">
    <span class="footer-hill hill-back"></span>
    <span class="footer-hill hill-front"></span>
    <span class="footer-river"></span>
    <span class="footer-lamp lamp-one"></span>
    <span class="footer-lamp lamp-two"></span>
  </div>
  <div class="footer-content wrap">
    <a class="brand footer-brand" href="/">
      <img src={worldMark.src} width="40" height="40" alt="" />
      <span>Agent Toolkit</span>
    </a>
    <p>Real projects. Reusable People. Honest runtime.</p>
    <nav aria-label="Footer navigation">
      <a href="/download/">Download</a>
      <a href="/docs/">Documentation</a>
      <a href="/capabilities/">Capabilities</a>
      <a href="/community/">Community</a>
      <a href="https://github.com/ulises-jeremias/agent-toolkit">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <small>
      Built in the Agent Toolkit valley. Open source under the MIT License.
    </small>
  </div>
</footer>
