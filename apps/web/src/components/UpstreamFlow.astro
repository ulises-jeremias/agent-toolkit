        The source and license are named.
      </span>
    </article>
    <svg
      class="upstream-flow__wire"
      viewBox="0 0 100 30"
      aria-hidden="true"
      focusable="false"
    >
      <path class="upstream-flow__line" d="M3 15 H92 M84 6 L94 15 L84 24" />
      <path class="upstream-flow__spark" d="M3 15 H92" />
    </svg>
    <article class="upstream-flow__node upstream-flow__node--toolkit">
