---
const navigation = [
  { href: "/capabilities/", label: "Explore" },
  { href: "/docs/", label: "Field guide" },
  { href: "/docs/installation/", label: "Install CLI" },
];
const pathname = Astro.url.pathname;
const currentHref = navigation
  .filter((item) => pathname.startsWith(item.href))
  .sort((left, right) => right.href.length - left.href.length)[0]?.href;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label="Agent Toolkit home">
      <img src="/favicon.svg" width="40" height="40" alt="" />
      <span>Agent Toolkit</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={currentHref === item.href ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="nav-download" href="https://www.veasel.dev/downloads/">
        Veasel Code <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={currentHref === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
        <a href="https://www.veasel.dev/downloads/">Get Veasel Code ↗</a>
      </nav>
    </details>
  </div>
</header>
