{
  "name": "agent-toolkit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Toolkit Desktop — Electron + React workstation over the `agent-toolkit serve` backend",
  "author": "ulises-jeremias",
  "license": "MIT",
  "homepage": "https://github.com/ulises-jeremias/agent-toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulises-jeremias/agent-toolkit.git",
    "directory": "apps/desktop"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "pnpm build:electron && electron .",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.node.json --noEmit false --outDir dist-electron --rootDir electron",
    "build:all": "pnpm build && pnpm build:electron",
    "stage:backend": "node scripts/stage-backend.mjs",
    "dist": "pnpm stage:backend && pnpm build:all && electron-builder",
    "dist:dir": "pnpm stage:backend && pnpm build:all && electron-builder --dir",
    "gen:api": "node scripts/gen-api.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.2",
    "react-router": "^8.4.0",
    "web-vitals": "^6.0.1",
    "xterm": "^5.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.1",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.0.2"
  }
}
