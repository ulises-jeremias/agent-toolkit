  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Error body for every non-2xx JSON response.",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "error"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "description": "Generic success acknowledgement.",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "message"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "uptime_s": {
            "type": "integer"
          }
        },
        "required": [
          "ok",
          "version",
          "commit",
          "uptime_s"
        ]
      },
      "SelfcheckCheck": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "err"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ]
      },
      "SelfcheckResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelfcheckCheck"
            }
          }
        },
        "required": [
          "ok",
          "version",
          "commit",
          "checks"
        ]
      },
      "Job": {
        "type": "object",
        "description": "A supervised `agent-toolkit` subprocess run.",
        "properties": {
          "id": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "canceled",
              "rejected"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "workspace": {
            "type": "string"
          },
          "retry_of": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "cmd",
          "args",
          "status",
          "started_at",
          "ended_at",
          "exit_code",
          "workspace",
          "retry_of"
        ]
      },
      "ApiEvent": {
        "type": "object",
        "description": "One entry of the global event stream (GET /api/v1/events). `seq` is monotonic per server process, `boot` identifies that process, and the SSE `id` is `<boot>-<seq>`. `subject` is the job id, loop name, swarm run id or memory entry type the event is about; `exit_code` is only meaningful for job.* and loop.* events.",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "boot": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "backend.ready",
              "backend.resync",
              "job.created",
              "job.updated",
              "job.deleted",
              "loop.started",
              "loop.finished",
              "swarm.changed",
              "memory.changed",
              "install.started",
              "install.finished"
            ]
          },
          "at": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "ref": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "seq",
          "boot",
          "type",
          "at",
          "subject",
          "status",
          "exit_code",
          "ref",
          "message"
        ]
      }
    }
  }
}
