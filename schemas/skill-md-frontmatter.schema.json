{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ulises-jeremias/agent-toolkit/main/schemas/skill-md-frontmatter.schema.json",
  "title": "agent-toolkit SKILL.md Frontmatter",
  "description": "YAML frontmatter schema for bundled SKILL.md files. All fields except name and description are optional to maintain backwards compatibility.",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case skill name (must match the directory name and skill.json name)."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable summary (used in skill selection)."
    },
    "metadata": {
      "type": "object",
      "description": "Optional skill metadata.",
      "additionalProperties": true,
      "properties": {
        "author": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "requires": {
      "type": "array",
      "description": "CLI tools, commands, or env vars this skill needs.",
      "items": { "type": "string" }
    },
    "produces": {
      "type": "array",
      "description": "Artifact types this skill outputs (e.g. plan.md, PR, comment).",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "description": "AI tools this SKILL.md is verified to work with.",
      "items": {
        "type": "string",
        "enum": ["claude-code", "opencode", "cursor", "windsurf", "copilot-cli", "pi", "universal"]
      }
    },
    "triggers": {
      "type": "array",
      "description": "Natural-language phrases or events that should invoke this skill.",
      "items": { "type": "string" }
    },
    "compatibility": {
      "type": "string",
      "description": "Human-readable compatibility note (prerequisites, caveats)."
    },
    "upstream": {
      "type": "object",
      "description": "Provenance for third-party capabilities (per #364). Omit for first-party bundled skills.",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$",
          "description": "GitHub repo owner/repo"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Path within upstream repo"
        },
        "ref": {
          "type": "string",
          "minLength": 7,
          "pattern": "^(?!main$|master$|latest$|HEAD$)[a-zA-Z0-9._/\\-]+$",
          "description": "Immutable tag or commit SHA (must NOT be main/master/latest)"
        },
        "license": {
          "type": "string",
          "description": "SPDX identifier or 'unknown'"
        },
        "author": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["repository", "path", "ref", "license"]
    },
    "trust": {
      "type": "object",
      "description": "Trust tier (per #364)",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["first-party", "verified", "community", "experimental"]
        }
      }
    },
    "distribution": {
      "type": "object",
      "description": "Distribution mode",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["vendored", "external", "generated", "native-plugin"]
        },
        "redistribution_allowed": { "type": "boolean" }
      }
    },
    "security": {
      "type": "object",
      "description": "Security surface declaration",
      "additionalProperties": false,
      "properties": {
        "scripts": { "type": "boolean" },
        "shell": { "type": "boolean" },
        "network": { "type": "boolean" },
        "mcp": { "type": "array", "items": { "type": "string" } },
        "hooks": { "type": "array", "items": { "type": "string" } },
        "dangerous_permissions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
