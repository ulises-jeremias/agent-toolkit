  .stat {{ background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; text-align: center; }}
  .stat-value {{ font-size: 1.6rem; font-weight: bold; color: var(--accent); }}
  .stat-label {{ font-size: 0.8rem; color: var(--muted); margin-top: 0.25rem; }}
  .tag {{ display: inline-block; background: #1f3a5f; color: var(--accent); border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.8rem; margin: 0.15rem; }}
  .area {{ background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; display: flex; gap: 1rem; align-items: flex-start; }}
  .area-count {{ background: #1f3a5f; color: var(--accent); border-radius: 6px; padding: 0.25rem 0.6rem; font-weight: bold; white-space: nowrap; font-size: 0.9rem; }}
  .friction-category {{ border-left: 3px solid var(--orange); padding-left: 1rem; margin-bottom: 1rem; }}
  .friction-example {{ color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem; font-style: italic; }}
  .prompt-box {{ background: #0d1117; border: 1px solid var(--border); border-radius: 6px; padding: 1rem; font-family: monospace; font-size: 0.82rem; color: #a8d8a8; margin-top: 0.75rem; white-space: pre-wrap; word-break: break-word; }}
  .fun-box {{ background: linear-gradient(135deg, #1f1b33, #1a2332); border: 1px solid var(--purple); border-radius: 8px; padding: 1.25rem; text-align: center; margin-top: 2rem; }}
  .fun-headline {{ font-size: 1.1rem; color: var(--purple); font-weight: bold; margin-bottom: 0.5rem; }}
  .tool-bar {{ display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }}
  .tool-chip {{ display: inline-block; border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.78rem; font-weight: bold; }}
  .tool-primary {{ background: #1a3a1f; color: var(--green); }}
  .tool-secondary {{ background: #1f3a5f; color: var(--accent); }}
  .tool-occasional {{ background: #2a1f3a; color: var(--purple); }}
  p {{ margin-bottom: 0.75rem; color: var(--muted); }}
  p:last-child {{ margin-bottom: 0; }}
</style>
</head>
<body>
<div class="container">
  <h1>{tool} Usage Insights</h1>
  <p class="subtitle">Generated {generated_at}</p>

  <div class="stat-grid">
    {stat_cards}
  </div>

  <h2>At a Glance</h2>
  <div class="card">
    <p style="color:var(--text)">{headline_stats}</p>
    <h3>What's Working</h3><p>{whats_working}</p>
    <h3>What's Hindering</h3><p>{whats_hindering}</p>
    <h3>Quick Wins</h3><p>{quick_wins}</p>
  </div>

  {tool_breakdown_section}

  <h2>Project Areas</h2>
  {project_areas_html}

  <h2>Interaction Style</h2>
  <div class="card">
    {interaction_style_html}
    <p style="margin-top:0.75rem"><strong style="color:var(--accent)">Key pattern:</strong> {key_pattern}</p>
  </div>

  <h2>What Works Well</h2>
  <div class="card">
    <p>{works_intro}</p>
    {impressive_workflows_html}
  </div>

  <h2>Where Things Go Wrong</h2>
  <div class="card">
    <p>{friction_intro}</p>
    {friction_html}
  </div>

  <h2>Suggestions</h2>
  {suggestions_html}

  <div class="fun-box">
    <div class="fun-headline">"{fun_headline}"</div>
    <p style="margin:0;color:var(--muted)">{fun_detail}</p>
  </div>
</div>
</body>
</html>"""


def _make_stat_cards(tool_key: str, raw_stats: dict) -> str:
    """Build stat card HTML for a single tool or aggregate report."""
    cards = ""
    if tool_key == "opencode":
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_sessions", 0)}</div><div class="stat-label">Total Sessions</div></div>'
        cost = raw_stats.get("total_cost", 0) or 0
        cards += f'<div class="stat"><div class="stat-value">${cost:,.2f}</div><div class="stat-label">Total Cost</div></div>'
        ti = raw_stats.get("total_tokens_in", 0) or 0
        to_ = raw_stats.get("total_tokens_out", 0) or 0
        cards += f'<div class="stat"><div class="stat-value">{(ti + to_) / 1e6:.1f}M</div><div class="stat-label">Total Tokens</div></div>'
        date_range = f"{(raw_stats.get('first_session') or '')[:10]} → {(raw_stats.get('last_session') or '')[:10]}"
        cards += f'<div class="stat"><div class="stat-value" style="font-size:1rem">{date_range}</div><div class="stat-label">Date Range</div></div>'
    elif tool_key == "cursor":
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_transcripts", 0)}</div><div class="stat-label">Total Transcripts</div></div>'
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_projects", 0)}</div><div class="stat-label">Projects</div></div>'
    elif tool_key == "claude":
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_sessions", 0)}</div><div class="stat-label">Total Sessions</div></div>'
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_projects", 0)}</div><div class="stat-label">Projects</div></div>'
        first = (raw_stats.get("first_session") or "")[:10]
        last = (raw_stats.get("last_session") or "")[:10]
        if first:
            cards += f'<div class="stat"><div class="stat-value" style="font-size:1rem">{first} → {last}</div><div class="stat-label">Date Range</div></div>'
    elif tool_key == "windsurf":
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_sessions", 0)}</div><div class="stat-label">Sessions Found</div></div>'
        cards += f'<div class="stat"><div class="stat-value">{raw_stats.get("total_projects", 0)}</div><div class="stat-label">Directories</div></div>'
    elif tool_key == "all":
        summary = raw_stats.get("tool_summary", [])
        total = sum(t.get("sessions", 0) for t in summary)
        cards += f'<div class="stat"><div class="stat-value">{total}</div><div class="stat-label">Total Sessions (All Tools)</div></div>'
        dominant = summary[0]["tool"].title() if summary else "—"
        cards += f'<div class="stat"><div class="stat-value" style="font-size:1.2rem">{dominant}</div><div class="stat-label">Most Used Tool</div></div>'
        cards += f'<div class="stat"><div class="stat-value">{len(summary)}</div><div class="stat-label">Tools Tracked</div></div>'
        first = (raw_stats.get("first_session") or "")[:10]
        last = (raw_stats.get("last_session") or "")[:10]
        if first:
            cards += f'<div class="stat"><div class="stat-value" style="font-size:1rem">{first} → {last}</div><div class="stat-label">Date Range</div></div>'
    return cards


def _make_tool_breakdown_section(analysis: dict) -> str:
    """Render the tool breakdown section for 'all' reports."""
    breakdown = analysis.get("tool_breakdown", [])
    if not breakdown:
        return ""
    rows = ""
    for entry in breakdown:
        role = entry.get("role", "secondary")
        chip_class = {"primary": "tool-primary", "secondary": "tool-secondary", "occasional": "tool-occasional"}.get(role, "tool-secondary")
        share = entry.get("share_pct", 0)
        rows += f"""<div class="area">
          <div><span class="tool-chip {chip_class}">{entry.get('tool','').upper()}</span></div>
          <div>
            <strong>{entry.get('sessions', 0)} sessions</strong>
            <span style="color:var(--muted);font-size:0.85rem"> ({share}% · {role})</span>
            <br><span style="color:var(--muted);font-size:0.9rem">{entry.get('description','')}</span>
          </div>
        </div>"""
    return f'<h2>Tool Breakdown</h2>\n{rows}'


def render_html(tool_key: str, tool_display: str, raw_stats: dict, analysis: dict) -> str:
    generated_at = datetime.now().strftime("%Y-%m-%d %H:%M")
    ag = analysis.get("at_a_glance", {})

    stat_cards = _make_stat_cards(tool_key, raw_stats)

    # tool breakdown (only for 'all')
    tool_breakdown_section = _make_tool_breakdown_section(analysis) if tool_key == "all" else ""

    # project areas
    areas_html = ""
    for area in analysis.get("project_areas", []):
        count = area.get("session_count", "?")
        tools_used = area.get("tools_used", [])
        tools_html = "".join(f'<span class="tag">{t}</span>' for t in tools_used) if tools_used else ""
        areas_html += f'''<div class="area">
          <div class="area-count">{count}</div>
          <div><strong>{area.get("name","")}</strong>{(" " + tools_html) if tools_html else ""}<br><span style="color:var(--muted);font-size:0.9rem">{area.get("description","")}</span></div>
        </div>'''

    # interaction style
    narrative = analysis.get("interaction_style", {}).get("narrative", "")
    paragraphs = [f"<p>{p.strip()}</p>" for p in narrative.split("\n\n") if p.strip()] or [f"<p>{narrative}</p>"]
    interaction_html = "".join(paragraphs)
    key_pattern = analysis.get("interaction_style", {}).get("key_pattern", "")

    # impressive workflows
    ww = analysis.get("what_works", {})
    workflows_html = ""
    for wf in ww.get("impressive_workflows", []):
        workflows_html += f'<h3>{wf.get("title","")}</h3><p>{wf.get("description","")}</p>'

    # friction
    fr = analysis.get("friction_analysis", {})
    friction_html = ""
    for cat in fr.get("categories", []):
        examples_html = "".join(f'<div class="friction-example">• {e}</div>' for e in cat.get("examples", []))
        friction_html += f'''<div class="friction-category">
          <strong>{cat.get("category","")}</strong>
          <p style="margin:0.25rem 0">{cat.get("description","")}</p>
          {examples_html}
        </div>'''

    # suggestions
    suggestions_html = ""
    for s in analysis.get("suggestions", {}).get("patterns", []):
        prompt_html = ""
        if s.get("copyable_prompt"):
            prompt_html = f'<div class="prompt-box">{s["copyable_prompt"]}</div>'
        suggestions_html += f'''<div class="card">
          <h3>{s.get("title","")}</h3>
          <p><strong style="color:var(--text)">{s.get("suggestion","")}</strong></p>
          <p>{s.get("detail","")}</p>
          {prompt_html}
        </div>'''

    fun = analysis.get("fun_ending", {})

    return HTML_TEMPLATE.format(
        tool=tool_display,
        generated_at=generated_at,
        stat_cards=stat_cards,
        tool_breakdown_section=tool_breakdown_section,
        headline_stats=ag.get("headline_stats", ""),
        whats_working=ag.get("whats_working", ""),
        whats_hindering=ag.get("whats_hindering", ""),
        quick_wins=ag.get("quick_wins", ""),
        project_areas_html=areas_html,
        interaction_style_html=interaction_html,
        key_pattern=key_pattern,
        works_intro=ww.get("intro", ""),
        impressive_workflows_html=workflows_html,
        friction_intro=fr.get("intro", ""),
        friction_html=friction_html,
        suggestions_html=suggestions_html,
        fun_headline=fun.get("headline", ""),
        fun_detail=fun.get("detail", ""),
    )


# ── Main ──────────────────────────────────────────────────────────────────────

def usage():
    print("""Usage: tool-insights [TOOL...] [--days N] [--output PATH] [--no-llm]

TOOL can be one or more of:
  opencode   — OpenCode sessions (~/.local/share/opencode/opencode.db)
  cursor     — Cursor agent transcripts (~/.cursor/projects/)
  claude     — Claude Code JSONL sessions (~/.claude/projects/)
  windsurf   — Windsurf session data (~/.codeium/windsurf/ or ~/.windsurf/)
  copilot    — GitHub Copilot usage (no local store yet — reports "no data")
  codex      — Codex sessions (no local store yet — reports "no data")
  pi         — Pi agent sessions (no local store yet — reports "no data")
  muse       — Muse Code sessions (no local store yet — reports "no data")
  all        — Aggregate report across all available tools

Options:
  --days N     Limit to last N days (opencode, claude, windsurf)
  --output PATH  Save HTML report to PATH (else to ~/.claude/usage-data/)
  --no-llm   Skip LLM analysis; output raw JSON stats only

If no TOOL is specified, defaults to: opencode cursor claude windsurf
""")


def main():
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        usage()
        sys.exit(0)

    no_llm = "--no-llm" in args
    args = [a for a in args if a != "--no-llm"]

    # --- parse --days and --output (for V CLI wrapper) ---
    days = 0
    output_path = None
    filtered_args = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--days" and i + 1 < len(args):
            try:
                days = int(args[i + 1])
            except ValueError:
                print(f"ERROR: --days requires an integer, got '{args[i+1]}'", file=sys.stderr)
                sys.exit(1)
            i += 2
            continue
        elif a.startswith("--days="):
            try:
                days = int(a.split("=", 1)[1])
            except ValueError:
                print(f"ERROR: --days requires an integer, got '{a}'", file=sys.stderr)
                sys.exit(1)
            i += 1
            continue
        elif a == "--output" and i + 1 < len(args):
            output_path = Path(args[i + 1]).expanduser()
            i += 2
            continue
        elif a.startswith("--output="):
            output_path = Path(a.split("=", 1)[1]).expanduser()
            i += 1
            continue
        else:
            filtered_args.append(a)
            i += 1
    args = filtered_args

    if not args:
        tools = KNOWN_TOOLS[:4]  # default: opencode cursor claude windsurf (not the stub tools)
    else:
        tools = args

    # Validate
    valid = set(KNOWN_TOOLS) | {"all"}
    unknown = [t for t in tools if t not in valid]
    if unknown:
        print(f"ERROR: Unknown tool(s): {', '.join(unknown)}", file=sys.stderr)
        print(f"Valid tools: {', '.join(sorted(valid))}", file=sys.stderr)
        sys.exit(1)

    if not no_llm and not ANTHROPIC_API_KEY:
        print("ERROR: ANTHROPIC_API_KEY not set (use --no-llm for raw stats only)", file=sys.stderr)
        sys.exit(1)

    # If "all" is in the list, also ensure the individual tools are collected
    run_all = "all" in tools
    individual_tools = [t for t in tools if t != "all"]
    if run_all and not individual_tools:
        individual_tools = KNOWN_TOOLS

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y-%m-%d-%H%M%S")
    generated = []
    stats_by_tool: dict[str, dict] = {}

    # ── Per-tool reports ───────────────────────────────────────────────────

    if "opencode" in individual_tools:
        print("→ Extracting OpenCode data...")
        if days:
            print(f"  Filtering to last {days} days")
        if not OPENCODE_DB.exists():
            print("  No data found for opencode: DB not found at ~/.local/share/opencode/opencode.db")
        else:
            raw = extract_opencode_stats(OPENCODE_DB, days=days)
            stats_by_tool["opencode"] = raw
            print(f"  {raw['total_sessions']} sessions, ${raw.get('total_cost', 0) or 0:.2f} cost")
            if not no_llm and "opencode" in tools:
                print("  Analyzing with Claude...")
                analysis = analyze_with_claude("OpenCode", raw)
                html = render_html("opencode", "OpenCode", raw, analysis)
                out = _resolve_output_path("opencode", timestamp, output_path, tools, individual_tools)
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(html)
                print(f"  Report: file://{out}")
                generated.append(("OpenCode", out))
            elif no_llm and output_path is not None and "opencode" in tools and len(individual_tools) == 1:
                # --no-llm with --output: write raw JSON to the requested path (keep exact path)
                out = output_path
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(json.dumps(raw, indent=2, default=str))
                print(f"  Raw stats: file://{out}")
                generated.append(("OpenCode (raw)", out))

    if "cursor" in individual_tools:
        print("→ Extracting Cursor data...")
        if not CURSOR_PROJECTS.exists():
            print("  No data found for cursor: projects dir not found at ~/.cursor/projects/")
        else:
            raw = extract_cursor_stats(CURSOR_PROJECTS)
            stats_by_tool["cursor"] = raw
            print(f"  {raw['total_transcripts']} transcripts across {raw['total_projects']} projects")
            if not no_llm and "cursor" in tools:
                print("  Analyzing with Claude...")
                analysis = analyze_with_claude("Cursor", raw)
                html = render_html("cursor", "Cursor", raw, analysis)
                out = _resolve_output_path("cursor", timestamp, output_path, tools, individual_tools)
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(html)
                print(f"  Report: file://{out}")
                generated.append(("Cursor", out))

    if "claude" in individual_tools:
        print("→ Extracting Claude Code data...")
        if not CLAUDE_PROJECTS.exists():
            print("  No data found for claude: projects dir not found at ~/.claude/projects/")
        else:
            raw = extract_claude_stats(CLAUDE_PROJECTS)
            stats_by_tool["claude"] = raw
            print(f"  {raw['total_sessions']} sessions across {raw['total_projects']} projects")
            if not no_llm and "claude" in tools:
                print("  Analyzing with Claude...")
                analysis = analyze_with_claude("Claude Code", raw)
                html = render_html("claude", "Claude Code", raw, analysis)
                out = _resolve_output_path("claude", timestamp, output_path, tools, individual_tools)
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(html)
                print(f"  Report: file://{out}")
                generated.append(("Claude Code", out))

    if "windsurf" in individual_tools:
        print("→ Extracting Windsurf data...")
        windsurf_dir = _find_windsurf_dir()
        if windsurf_dir is None:
            print("  No data found for windsurf: no data directory found (~/.codeium/windsurf/, ~/.windsurf/)")
        else:
            raw = extract_windsurf_stats(windsurf_dir)
            stats_by_tool["windsurf"] = raw
            sessions = raw.get("total_sessions", 0)
            if sessions == 0:
                print(f"  No session data found in {windsurf_dir} (directory exists but no conversation files)")
            else:
                print(f"  {sessions} sessions/entries found in {windsurf_dir}")
                if not no_llm and "windsurf" in tools:
                    print("  Analyzing with Claude...")
                    analysis = analyze_with_claude("Windsurf", raw)
                    html = render_html("windsurf", "Windsurf", raw, analysis)
                    out = _resolve_output_path("windsurf", timestamp, output_path, tools, individual_tools)
                    out.parent.mkdir(parents=True, exist_ok=True)
                    out.write_text(html)
                    print(f"  Report: file://{out}")
                    generated.append(("Windsurf", out))

    # ── Aggregate "all" report ─────────────────────────────────────────────

    if run_all:
        print("→ Building aggregate report...")
        if not stats_by_tool:
            print("  No tool data available for aggregate report.")
        else:
            agg = extract_all_stats(stats_by_tool)
            total = sum(t.get("sessions", 0) for t in agg.get("tool_summary", []))
            print(f"  {total} total sessions across {len(stats_by_tool)} tools")
            if not no_llm:
                print("  Analyzing with Claude...")
                analysis = analyze_with_claude("All AI Tools", agg, is_all=True)
                html = render_html("all", "All AI Tools", agg, analysis)
                if output_path is not None and ("all" in tools or len(individual_tools) > 1):
                    out = output_path if output_path.suffix in (".html", ".htm") else output_path / f"all-insights-{timestamp}.html"
                else:
                    out = OUTPUT_DIR / f"all-insights-{timestamp}.html"
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(html)
                print(f"  Report: file://{out}")
                generated.append(("All AI Tools", out))
            else:
                # In no-llm mode, write raw JSON
                if output_path is not None and ("all" in tools or len(individual_tools) > 1):
                    out = output_path if output_path.suffix == ".json" else output_path / f"all-insights-{timestamp}.json" if output_path.is_dir() or not output_path.suffix else output_path
                    # if output_path is a file with .html suffix but no_llm, keep json ext
                    if output_path.suffix in (".html", ".htm"):
                        out = output_path.with_suffix(".json")
                else:
                    out = OUTPUT_DIR / f"all-insights-{timestamp}.json"
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_text(json.dumps(agg, indent=2, default=str))
                print(f"  Raw stats: file://{out}")
                generated.append(("All AI Tools (raw)", out))

    # ── Summary ───────────────────────────────────────────────────────────

    print("\nDone.")
    for tool_name, path in generated:
        print(f"  {tool_name}: file://{path}")


if __name__ == "__main__":
    main()
