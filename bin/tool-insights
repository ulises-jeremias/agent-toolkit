#!/usr/bin/env python3
"""Generate usage insights for AI coding tools: OpenCode, Cursor, Claude Code, Windsurf."""

import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# Self-bootstrapping venv — installs anthropic on first run
VENV_DIR = Path.home() / ".local/share/tool-insights-venv"

def _bootstrap_venv():
    import venv as _venv_mod
    _venv_mod.create(str(VENV_DIR), with_pip=True, clear=False)
    pip = VENV_DIR / "bin" / "pip"
    subprocess.check_call([str(pip), "install", "anthropic", "--quiet"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def _ensure_venv():
    marker = VENV_DIR / "lib"
    if not marker.exists():
        print("→ Setting up tool-insights venv (first run)...", file=sys.stderr)
        _bootstrap_venv()
    # Re-exec under venv python if not already there
    venv_py = VENV_DIR / "bin" / "python"
    if sys.executable != str(venv_py) and venv_py.exists():
        os.execv(str(venv_py), [str(venv_py)] + sys.argv)

_ensure_venv()

ANTHROPIC_API_KEY = os.environ.get("ANTHROPIC_API_KEY", "")
OPENCODE_DB = Path.home() / ".local/share/opencode/opencode.db"
CURSOR_PROJECTS = Path.home() / ".cursor/projects"
CLAUDE_PROJECTS = Path.home() / ".claude/projects"
WINDSURF_DIRS = [
    Path.home() / ".codeium" / "windsurf",
    Path.home() / ".windsurf",
]
OUTPUT_DIR = Path.home() / ".claude/usage-data"

SAMPLE_SESSIONS = 60   # how many recent sessions to send for narrative analysis
SAMPLE_MSGS_PER_SESSION = 3  # first user msgs to capture intent

KNOWN_TOOLS = ["opencode", "cursor", "claude", "windsurf", "copilot", "codex", "pi", "muse"]

def _resolve_output_path(tool_key: str, timestamp: str, output_path: Path | None, tools: list[str], individual_tools: list[str]) -> Path:
    """Resolve output path for a tool's HTML report."""
    if output_path is not None:
        # If single tool requested and output is a file, use it directly
        if len(individual_tools) == 1 and tool_key in tools:
            if output_path.suffix in (".html", ".htm") or not output_path.exists() or output_path.is_file():
                return output_path
            # output is a directory
            return output_path / f"{tool_key}-insights-{timestamp}.html"
        # For "all" or multi-tool, if output is a file, use it for aggregate, else per-tool
        if tool_key == "all" and output_path.suffix in (".html", ".htm"):
            return output_path
    # default: OUTPUT_DIR with timestamp
    return OUTPUT_DIR / f"{tool_key}-insights-{timestamp}.html"


# ── OpenCode ──────────────────────────────────────────────────────────────────

def extract_opencode_stats(db_path: Path, days: int = 0) -> dict:
    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    con.row_factory = sqlite3.Row
    cur = con.cursor()

    # days filter: only sessions created in last N days (if requested)
    days_where = ""
    days_params: tuple = ()
    if days and days > 0:
        days_where = " AND time_created >= (strftime('%s','now','-{} days')*1000)".format(days)

    # aggregate
    cur.execute(f"""
        SELECT
            COUNT(*) total_sessions,
            SUM(cost) total_cost,
            SUM(tokens_input) total_tokens_in,
            SUM(tokens_output) total_tokens_out,
            MIN(datetime(time_created/1000,'unixepoch')) first_session,
            MAX(datetime(time_updated/1000,'unixepoch')) last_session
        FROM session WHERE time_archived IS NULL{days_where}
    """ , days_params)
    agg = dict(cur.fetchone())

    # by model
    cur.execute(f"""
        SELECT
            COALESCE(json_extract(model,'$.id'), 'unknown') model_id,
            COALESCE(json_extract(model,'$.providerID'), 'unknown') provider,
            COUNT(*) sessions, SUM(cost) cost, SUM(tokens_input+tokens_output) tokens
        FROM session WHERE time_archived IS NULL{days_where}
        GROUP BY model_id ORDER BY sessions DESC LIMIT 20
    """ , days_params)
    agg["by_model"] = [dict(r) for r in cur.fetchall()]

    # by directory (top projects)
    cur.execute(f"""
        SELECT
            REPLACE(directory, '/home/ulisesjcf', '~') as dir,
            COUNT(*) sessions, SUM(cost) cost, SUM(tokens_input+tokens_output) tokens
        FROM session WHERE time_archived IS NULL{days_where}
        GROUP BY directory ORDER BY sessions DESC LIMIT 20
    """ , days_params)
    agg["by_directory"] = [dict(r) for r in cur.fetchall()]

    # recent sessions sample for narrative
    cur.execute(f"""
        SELECT
            s.id, s.title,
            REPLACE(s.directory, '/home/ulisesjcf', '~') as directory,
            json_extract(s.model,'$.id') model,
            json_extract(s.model,'$.providerID') provider,
            s.cost, s.tokens_input, s.tokens_output,
            s.summary_additions, s.summary_deletions, s.summary_files,
            datetime(s.time_created/1000,'unixepoch') created,
            datetime(s.time_updated/1000,'unixepoch') updated
        FROM session s WHERE s.time_archived IS NULL{days_where.replace('time_created', 's.time_created')}
        ORDER BY s.time_created DESC LIMIT ?
    """, (SAMPLE_SESSIONS,))
    sessions = [dict(r) for r in cur.fetchall()]

    # for each session grab first few user messages
    for s in sessions:
        cur.execute("""
            SELECT json_extract(p.data,'$.text') as text
            FROM part p
            JOIN message m ON m.id = p.message_id
            WHERE p.session_id = ?
              AND json_extract(p.data,'$.type') = 'text'
              AND json_extract(m.data,'$.role') = 'user'
            ORDER BY p.time_created LIMIT ?
        """, (s["id"], SAMPLE_MSGS_PER_SESSION))
        rows = cur.fetchall()
        s["user_messages"] = [r[0][:400] for r in rows if r[0]]

    con.close()
    agg["sessions_sample"] = sessions
    return agg


# ── Cursor ────────────────────────────────────────────────────────────────────

def extract_cursor_stats(projects_dir: Path) -> dict:
    all_transcripts = []
    project_counts = {}

    for project_dir in sorted(projects_dir.iterdir()):
        transcripts_dir = project_dir / "agent-transcripts"
        if not transcripts_dir.exists():
            continue
        project_name = project_dir.name
        jsonl_files = sorted(transcripts_dir.rglob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
        project_counts[project_name] = len(jsonl_files)
        all_transcripts.extend((f, project_name) for f in jsonl_files[:5])  # top 5 per project

    # sort all by mtime, take most recent SAMPLE_SESSIONS
    all_transcripts.sort(key=lambda t: t[0].stat().st_mtime, reverse=True)
    sample = all_transcripts[:SAMPLE_SESSIONS]

    sessions_sample = []
    for jsonl_path, project in sample:
        try:
            lines = jsonl_path.read_text(errors="replace").splitlines()
            user_msgs = []
            tool_calls = 0
            for line in lines:
                try:
                    obj = json.loads(line)
                    role = obj.get("role") or (obj.get("message") or {}).get("role")
                    if role == "user":
                        content = obj.get("message", {}).get("content", [])
                        for part in content:
                            if isinstance(part, dict) and part.get("type") == "text":
                                txt = part.get("text", "")
                                # strip timestamp tags
                                txt = re.sub(r"<timestamp>[^<]*</timestamp>", "", txt).strip()
                                user_query = re.search(r"<user_query>(.*?)</user_query>", txt, re.DOTALL)
                                if user_query:
                                    txt = user_query.group(1).strip()
                                if txt and len(user_msgs) < SAMPLE_MSGS_PER_SESSION:
                                    user_msgs.append(txt[:400])
                    if role == "assistant":
                        content = obj.get("message", {}).get("content", [])
                        tool_calls += sum(1 for p in content if isinstance(p, dict) and p.get("type") == "tool_use")
                except Exception:
                    continue

            sessions_sample.append({
                "project": project,
                "file": jsonl_path.name,
                "mtime": datetime.fromtimestamp(jsonl_path.stat().st_mtime).isoformat(),
                "size_kb": round(jsonl_path.stat().st_size / 1024, 1),
                "user_messages": user_msgs,
                "tool_calls": tool_calls,
            })
        except Exception:
            continue

    total_files = sum(project_counts.values())
    return {
        "total_transcripts": total_files,
        "total_projects": len(project_counts),
        "by_project": dict(sorted(project_counts.items(), key=lambda x: -x[1])[:20]),
        "sessions_sample": sessions_sample,
    }


# ── Claude Code ───────────────────────────────────────────────────────────────

def _decode_claude_project_dir(dir_name: str) -> str:
    """Convert Claude project dir name back to a readable path.

    Claude encodes the cwd as a dir name by replacing '/' with '-' and
    using '--' for the home dir separator. We simply humanise it back.
    """
    # Replace home prefix heuristically
    path = dir_name.lstrip("-").replace("-", "/")
    home = str(Path.home()).lstrip("/")
    if path.startswith(home):
        path = "~/" + path[len(home):].lstrip("/")
    return path or dir_name


def extract_claude_stats(projects_dir: Path) -> dict:
    """Extract stats from Claude Code JSONL session files."""
    project_counts: dict[str, int] = {}
    all_files: list[tuple[Path, str]] = []

    for project_dir in sorted(projects_dir.iterdir()):
        if not project_dir.is_dir():
            continue
        jsonl_files = sorted(project_dir.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
        if not jsonl_files:
            continue
        project_name = _decode_claude_project_dir(project_dir.name)
        project_counts[project_name] = len(jsonl_files)
        all_files.extend((f, project_name) for f in jsonl_files)

    all_files.sort(key=lambda t: t[0].stat().st_mtime, reverse=True)
    sample = all_files[:SAMPLE_SESSIONS]

    sessions_sample = []
    first_ts = None
    last_ts = None

    for jsonl_path, project in sample:
        try:
            lines = jsonl_path.read_text(errors="replace").splitlines()
            user_msgs: list[str] = []
            ai_title: str | None = None
            model: str | None = None
            cwd: str | None = None
            timestamps: list[str] = []

            for line in lines:
                try:
                    obj = json.loads(line)
                    t = obj.get("type")

                    if t == "ai-title":
                        ai_title = obj.get("aiTitle")

                    if t == "user":
                        msg = obj.get("message", {})
                        content = msg.get("content", "")
                        if isinstance(content, str) and content and len(user_msgs) < SAMPLE_MSGS_PER_SESSION:
                            user_msgs.append(content[:400])
                        elif isinstance(content, list):
                            for part in content:
                                if isinstance(part, dict) and part.get("type") == "text":
                                    txt = part.get("text", "")
                                    if txt and len(user_msgs) < SAMPLE_MSGS_PER_SESSION:
                                        user_msgs.append(txt[:400])
                        ts = obj.get("timestamp")
                        if ts:
                            timestamps.append(ts)
                        if not cwd:
                            cwd = obj.get("cwd")

                    if t == "assistant":
                        msg = obj.get("message", {})
                        if not model:
                            model = msg.get("model")

                except Exception:
                    continue

            # Date range tracking
            for ts in timestamps:
                try:
                    dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
                    if first_ts is None or dt < first_ts:
                        first_ts = dt
                    if last_ts is None or dt > last_ts:
                        last_ts = dt
                except Exception:
                    pass

            mtime = datetime.fromtimestamp(jsonl_path.stat().st_mtime)
            sessions_sample.append({
                "project": project,
                "file": jsonl_path.name,
                "title": ai_title,
                "model": model,
                "cwd": cwd.replace("/home/ulisesjcf", "~") if cwd else project,
                "mtime": mtime.isoformat(),
                "size_kb": round(jsonl_path.stat().st_size / 1024, 1),
                "user_messages": user_msgs,
            })
        except Exception:
            continue

    total_sessions = sum(project_counts.values())
    return {
        "total_sessions": total_sessions,
        "total_projects": len(project_counts),
        "by_project": dict(sorted(project_counts.items(), key=lambda x: -x[1])[:20]),
        "first_session": first_ts.strftime("%Y-%m-%d %H:%M:%S") if first_ts else None,
        "last_session": last_ts.strftime("%Y-%m-%d %H:%M:%S") if last_ts else None,
        "sessions_sample": sessions_sample,
    }


# ── Windsurf ──────────────────────────────────────────────────────────────────

def _find_windsurf_dir() -> Path | None:
    """Find the Windsurf data directory across known locations."""
    candidates = [
        Path.home() / ".codeium" / "windsurf",
        Path.home() / ".windsurf",
        Path.home() / ".config" / "windsurf",
        Path.home() / ".local" / "share" / "windsurf",
    ]
    for c in candidates:
        if c.exists() and c.is_dir():
            return c
    return None


def extract_windsurf_stats(windsurf_dir: Path) -> dict:
    """Extract stats from Windsurf session/conversation data.

    Windsurf stores conversations in various formats depending on version.
    We look for JSONL files, JSON conversation files, and SQLite DBs.
    """
    all_sessions: list[dict] = []
    project_counts: dict[str, int] = {}

    # Search for conversation / session files recursively
    for ext in ("*.jsonl", "*.json"):
        for f in sorted(windsurf_dir.rglob(ext), key=lambda p: p.stat().st_mtime, reverse=True):
            # Skip very large files (likely indexes)
            if f.stat().st_size > 10 * 1024 * 1024:
                continue
            try:
                content = f.read_text(errors="replace")
                if ext == "*.jsonl":
                    lines = [json.loads(l) for l in content.splitlines() if l.strip()]
                else:
                    try:
                        obj = json.loads(content)
                        lines = obj if isinstance(obj, list) else [obj]
                    except Exception:
                        continue

                user_msgs: list[str] = []
                for item in lines:
                    role = item.get("role") or item.get("type")
                    if role in ("user", "human"):
                        content_val = item.get("content") or item.get("text") or ""
                        if isinstance(content_val, str) and content_val.strip():
                            user_msgs.append(content_val[:400])
                        elif isinstance(content_val, list):
                            for part in content_val:
                                if isinstance(part, dict) and part.get("type") == "text":
                                    user_msgs.append(part.get("text", "")[:400])

                if not user_msgs:
                    continue  # skip files with no user content

                project = f.parent.name
                project_counts[project] = project_counts.get(project, 0) + 1
                all_sessions.append({
                    "project": project,
                    "file": f.name,
                    "mtime": datetime.fromtimestamp(f.stat().st_mtime).isoformat(),
                    "size_kb": round(f.stat().st_size / 1024, 1),
                    "user_messages": user_msgs[:SAMPLE_MSGS_PER_SESSION],
                })
                if len(all_sessions) >= SAMPLE_SESSIONS:
                    break
            except Exception:
                continue
        if len(all_sessions) >= SAMPLE_SESSIONS:
            break

    # Also look for SQLite databases
    for db_file in windsurf_dir.rglob("*.db"):
        if db_file.stat().st_size == 0:
            continue
        try:
            con = sqlite3.connect(f"file:{db_file}?mode=ro", uri=True)
            cur = con.cursor()
            cur.execute("SELECT name FROM sqlite_master WHERE type='table'")
            tables = {r[0] for r in cur.fetchall()}
            # Try common conversation table names
            for tbl in ("conversations", "sessions", "messages", "chats"):
                if tbl in tables:
                    cur.execute(f"SELECT COUNT(*) FROM {tbl}")  # noqa: S608
                    count = cur.fetchone()[0]
                    if count:
                        project_counts[f"db:{db_file.stem}"] = count
            con.close()
        except Exception:
            pass

    total = sum(project_counts.values())
    return {
        "total_sessions": total,
        "total_projects": len(project_counts),
        "by_project": dict(sorted(project_counts.items(), key=lambda x: -x[1])[:20]),
        "sessions_sample": all_sessions,
        "data_dir": str(windsurf_dir),
    }


# ── Aggregate (all tools) ──────────────────────────────────────────────────────

def extract_all_stats(stats_by_tool: dict[str, dict]) -> dict:
    """Build an aggregate summary across all tools."""
    tool_summary = []
    all_projects: dict[str, dict] = {}  # project -> {tool, sessions}
    date_min = None
    date_max = None

    for tool_key, raw in stats_by_tool.items():
        sessions = raw.get("total_sessions") or raw.get("total_transcripts", 0)
        cost = raw.get("total_cost")
        tokens_in = raw.get("total_tokens_in", 0) or 0
        tokens_out = raw.get("total_tokens_out", 0) or 0

        entry = {
            "tool": tool_key,
            "sessions": sessions,
        }
        if cost is not None:
            entry["cost_usd"] = round(cost, 4)
        if tokens_in or tokens_out:
            entry["total_tokens"] = tokens_in + tokens_out

        tool_summary.append(entry)

        # Merge by_project / by_directory
        by = raw.get("by_project") or {}
        if not by:
            # OpenCode uses by_directory
            by = {d["dir"]: d["sessions"] for d in raw.get("by_directory", [])}
        for project, count in by.items():
            if project not in all_projects:
                all_projects[project] = {"sessions": 0, "tools": []}
            all_projects[project]["sessions"] += count if isinstance(count, int) else count
            if tool_key not in all_projects[project]["tools"]:
                all_projects[project]["tools"].append(tool_key)

        # Date range
        for key in ("first_session", "last_session"):
            val = raw.get(key)
            if not val:
                continue
            try:
                dt = datetime.fromisoformat(val.replace("Z", "+00:00"))
                if key == "first_session":
                    if date_min is None or dt < date_min:
                        date_min = dt
                else:
                    if date_max is None or dt > date_max:
                        date_max = dt
            except Exception:
                pass

    tool_summary.sort(key=lambda x: -x["sessions"])
    top_projects = sorted(all_projects.items(), key=lambda x: -x[1]["sessions"])[:20]

    return {
        "tools_compared": list(stats_by_tool.keys()),
        "tool_summary": tool_summary,
        "top_projects": [
            {"project": p, **info} for p, info in top_projects
        ],
        "first_session": date_min.strftime("%Y-%m-%d") if date_min else None,
        "last_session": date_max.strftime("%Y-%m-%d") if date_max else None,
        # Merge all sessions_sample for narrative analysis (up to 40 total)
        "sessions_sample": [
            s
            for tool_key, raw in stats_by_tool.items()
            for s in [{**sess, "_tool": tool_key} for sess in raw.get("sessions_sample", [])]
        ][:40],
    }


# ── LLM Analysis ──────────────────────────────────────────────────────────────

ANALYSIS_PROMPT = """You are analyzing a developer's AI tool usage data to generate an insights report.

Below is structured data extracted from their {tool} sessions. Analyze it and return a JSON object with exactly this schema:

{{
  "at_a_glance": {{
    "headline_stats": "string with key numbers (sessions, date range, top models/projects)",
    "whats_working": "2-3 sentences on effective patterns",
    "whats_hindering": "2-3 sentences on friction points",
    "quick_wins": "2-3 sentences on easy improvements"
  }},
  "project_areas": [
    {{"name": "...", "session_count": N, "description": "..."}}
  ],
  "interaction_style": {{
    "narrative": "3-4 paragraph analysis of HOW they use {tool} — what's distinctive about their approach, task types, delegation patterns, quality bar",
    "key_pattern": "one-sentence summary of their defining usage pattern"
  }},
  "what_works": {{
    "intro": "one sentence",
    "impressive_workflows": [
      {{"title": "...", "description": "..."}}
    ]
  }},
  "friction_analysis": {{
    "intro": "one sentence",
    "categories": [
      {{"category": "...", "description": "...", "examples": ["..."]}}
    ]
  }},
  "suggestions": {{
    "patterns": [
      {{
        "title": "...",
        "suggestion": "...",
        "detail": "...",
        "copyable_prompt": "a ready-to-use prompt they can paste to act on this suggestion"
      }}
    ]
  }},
  "fun_ending": {{
    "headline": "one memorable/funny observation from the data",
    "detail": "one sentence expanding on it"
  }}
}}

Focus on being specific to THEIR data — mention actual project names, models used, patterns you see. Do not be generic.

{tool} USAGE DATA:
{data}
"""

ALL_ANALYSIS_PROMPT = """You are analyzing a developer's AI coding tool usage across multiple tools to generate an aggregate insights report.

Below is structured data extracted from their sessions across: {tools}.
Analyze it and return a JSON object with exactly this schema:

{{
  "at_a_glance": {{
    "headline_stats": "string with key numbers (total sessions across all tools, date range, dominant tool)",
    "whats_working": "2-3 sentences on effective patterns across tools",
    "whats_hindering": "2-3 sentences on friction points or tool overlap",
    "quick_wins": "2-3 sentences on easy improvements"
  }},
  "tool_breakdown": [
    {{"tool": "...", "sessions": N, "share_pct": N, "role": "primary/secondary/occasional", "description": "one sentence on how this tool is used"}}
  ],
  "project_areas": [
    {{"name": "...", "session_count": N, "tools_used": ["..."], "description": "..."}}
  ],
  "interaction_style": {{
    "narrative": "3-4 paragraph analysis of HOW they use AI tools overall — multi-tool strategy, task routing, delegation patterns",
    "key_pattern": "one-sentence summary of their defining AI usage pattern"
  }},
  "what_works": {{
    "intro": "one sentence",
    "impressive_workflows": [
      {{"title": "...", "description": "..."}}
    ]
  }},
  "friction_analysis": {{
    "intro": "one sentence",
    "categories": [
      {{"category": "...", "description": "...", "examples": ["..."]}}
    ]
  }},
  "suggestions": {{
    "patterns": [
      {{
        "title": "...",
        "suggestion": "...",
        "detail": "...",
        "copyable_prompt": "a ready-to-use prompt they can paste to act on this suggestion"
      }}
    ]
  }},
  "fun_ending": {{
    "headline": "one memorable/funny observation from the multi-tool data",
    "detail": "one sentence expanding on it"
  }}
}}

Focus on being specific to THEIR data — mention actual tool names, project names, patterns you see across tools. Do not be generic.

AGGREGATE USAGE DATA:
{data}
"""

def analyze_with_claude(tool: str, data: dict, is_all: bool = False) -> dict:
    import anthropic

    client = anthropic.Anthropic(api_key=ANTHROPIC_API_KEY)

    # trim sessions to keep prompt manageable
    payload = {k: v for k, v in data.items() if k != "sessions_sample"}
    payload["sessions_sample"] = data.get("sessions_sample", [])[:40]

    data_str = json.dumps(payload, indent=2, ensure_ascii=False)
    # hard cap at ~150k chars to stay within context
    if len(data_str) > 150_000:
        data_str = data_str[:150_000] + "\n... (truncated)"

    if is_all:
        tools_list = ", ".join(data.get("tools_compared", []))
        prompt = ALL_ANALYSIS_PROMPT.format(tool=tool, tools=tools_list, data=data_str)
    else:
        prompt = ANALYSIS_PROMPT.format(tool=tool, data=data_str)

    msg = client.messages.create(
        model="claude-sonnet-4-6",
        max_tokens=4096,
        messages=[{"role": "user", "content": prompt}],
    )
    text = msg.content[0].text
    # extract JSON from possible markdown fencing
    json_match = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.DOTALL)
    if json_match:
        text = json_match.group(1)
    else:
        # find first { to last }
        start = text.find("{")
        end = text.rfind("}") + 1
        if start != -1 and end > start:
            text = text[start:end]
    return json.loads(text)


# ── HTML Generation ───────────────────────────────────────────────────────────

HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{tool} Usage Insights</title>
<style>
  :root {{
    --bg: #0d1117; --surface: #161b22; --border: #30363d;
    --text: #e6edf3; --muted: #8b949e; --accent: #58a6ff;
    --green: #3fb950; --orange: #d29922; --red: #f85149; --purple: #bc8cff;
  }}
  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
  body {{ background: var(--bg); color: var(--text); font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',monospace; line-height: 1.6; }}
  .container {{ max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }}
  h1 {{ font-size: 1.8rem; margin-bottom: 0.25rem; }}
  h2 {{ font-size: 1.2rem; color: var(--accent); margin: 2rem 0 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }}
  h3 {{ font-size: 1rem; color: var(--green); margin: 1rem 0 0.5rem; }}
  .subtitle {{ color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }}
